APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data
SQLITE_PATH=./data/metadata.sqlite3
CHROMA_PATH=./data/chroma
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=pdf,txt,html,docx,pptx

# One Google AI Studio key authenticates both Gemini services below.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Default: local, private, zero per-request embedding cost.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_MODEL_CACHE=./data/models
LOCAL_EMBEDDING_BATCH_SIZE=8
ANSWER_CACHE_MAX_ITEMS=256
ANSWER_CACHE_TTL_SECONDS=900
QUERY_CACHE_MAX_ITEMS=512
QUERY_CACHE_TTL_SECONDS=3600
INJECTION_MODEL_ENABLED=false
INJECTION_MODEL_NAME=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_MODEL_THRESHOLD=0.9
GEMINI_THINKING_LEVEL=minimal
AUTH_ENABLED=true
AUTH_USERNAME=admin@example.com
AUTH_PASSWORD_HASH=generate-with-rag-auth-tool
AUTH_SECRET=replace-with-a-long-random-secret

RETRIEVAL_TOP_K=12
RERANK_TOP_N=5
MIN_RELEVANCE_SCORE=0.45
